# X (Twitter) API認証情報
# developer.x.com でアプリを作成して取得する
# このファイルを .env にコピーして値を入力する（.envはgitに含めない）

X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# note.com認証情報（自動ログイン用。未設定の場合は初回のみ手動ログイン）
NOTE_EMAIL=
NOTE_PASSWORD=

# Gemini API（サムネイル画像生成用）
# https://aistudio.google.com/app/apikey で取得
GEMINI_API_KEY=

# Claude Code 長期認証トークン（1年間有効）
# ~/.local/bin/claude setup-token で発行する
CLAUDE_CODE_OAUTH_TOKEN=
PYTHON_PATH=
